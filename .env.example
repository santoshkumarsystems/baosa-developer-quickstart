# Copy to .env, replace the key, and keep .env private (it is gitignored).
# The application defaults to MOCK mode even when this file is configured.
# Select LIVE mode in Streamlit or pass --mode live to the CLI to call Nebius.
# Live requests may incur charges. Never commit a real key.
NEBIUS_API_KEY=replace-with-your-own-api-key
# Optional; leave this default unless Nebius gives you another endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Optional; the model must be available to your Nebius account.
NEBIUS_MODEL=reflection/beam
